PORT=5001
NODE_ENV=development

# Option A (recommended for Enzonic): full mysql:// connection string.
# Keep this private; do not commit a real value.
DATABASE_URL=

# Option B: separate database fields (use these only if DATABASE_URL is blank).
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
DB_SSL=true
DB_CONNECTION_LIMIT=10

# Use a long, random secret. Never commit the real value.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma-separated exact frontend origins. Leave blank during local/Postman-only testing.
FRONTEND_ORIGIN=
